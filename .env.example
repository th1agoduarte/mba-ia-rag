# Chat provider: openai | anthropic | google
LLM_PROVIDER=openai
# Embedding provider: openai | google (Anthropic has no embeddings API).
# Changing it makes the next 'python -m app.index' rebuild the whole index.
EMBEDDING_PROVIDER=openai

# Only the keys of the selected providers are required.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5

GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.8-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_db
